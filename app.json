{
  "expo": {
    "name": "Geekly",
    "slug": "collection-app",
    "version": "5.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050B18",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050B18"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "backgroundColor": "#050B18",
      "adaptiveIcon": {
        "backgroundColor": "#050B18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.luckyflame.geekly",
      "androidStatusBar": {
        "translucent": false,
        "backgroundColor": "#050B18"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "99f92b1b-9222-4c27-8925-1dc4d9980013"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/99f92b1b-9222-4c27-8925-1dc4d9980013",
      "fallbackToCacheTimeout": 0,
      "checkOnLaunch": "ALWAYS"
    },
    "plugins": [
      "expo-localization",
      "expo-sharing",
      "expo-audio"
    ]
  }
}
